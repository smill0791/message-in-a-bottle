node_modules/
dist/
build/
.env
.env.*
!.env.example

# terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Saved plan files are binary, stale the moment they are written, and can
# contain resource attributes you would not want in git history.
tfplan
*.tfplan

# NOTE: .terraform.lock.hcl is deliberately NOT ignored. It pins provider
# versions and hashes so every machine and CI runner resolves identically.

# aws
.aws-sam/
credentials

# Written by scripts/deploy.sh so the notify step can quote a real URL. A
# build output, and stale the moment the stack is rebuilt.
.deploy-url

# editors / os
.DS_Store
.idea/
.vscode/
*.swp

# logs
*.log
npm-debug.log*

# vite
web/dist/
dist/

# terraform provider cache (large, machine-specific)
infra/.terraform/
